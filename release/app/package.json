{
  "name": "ai-kanban",
  "version": "4.6.0",
  "description": "A local desktop Kanban board for organizing prompts and running them with Claude Code agents",
  "license": "MIT",
  "author": "Tory Walker",
  "main": "./dist/main/main.js",
  "scripts": {
    "rebuild": "node -r ts-node/register ../../.erb/scripts/electron-rebuild.js",
    "postinstall": "node -r ts-node/register ../../.erb/scripts/electron-rebuild.js && node -r ts-node/register ../../.erb/scripts/link-modules.ts",
    "link-modules": "node -r ts-node/register ../../.erb/scripts/link-modules.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "node-pty": "1.1.0"
  }
}
